# URL RÉELLE du backend chatbot-backend — SERVEUR UNIQUEMENT.
# Jamais exposée au navigateur : lue par next.config.ts (proxy/rewrites) et
# par lib/server/backend-client.ts (fetch côté Server Components). Doit
# correspondre au "Server Base URL" du Swagger, ex:
# http://127.0.0.1:3337/chatbot-backend/api/v1
BACKEND_API_BASE_URL=http://127.0.0.1:3337/chatbot-backend/api/v1

# URL que le NAVIGATEUR appelle. Par défaut /api/backend (chemin relatif,
# proxifié par next.config.ts vers BACKEND_API_BASE_URL) : ne changez ceci
# que si vous voulez pointer le navigateur ailleurs (ex: environnement de
# preview avec un backend public).
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Valeur de l'en-tête x-application-id envoyée à l'API (facultatif).
NEXT_PUBLIC_APPLICATION_ID=

# URL du serveur socket.io temps réel (chat). Contrairement à
# NEXT_PUBLIC_API_BASE_URL, cette URL N'EST PAS proxifiée : les upgrades
# WebSocket ne passent pas de façon fiable par les rewrites() de Next.js, donc
# le navigateur s'y connecte directement, comme dans le projet précédent
# (chatbot-backoffice). Adaptez host/port à votre backend si besoin.
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3337/ws
